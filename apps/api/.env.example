# ============================================================
# Backend environment — copy to apps/api/.env for local dev.
# When running via Docker Compose, values come from the root .env.
# ============================================================

# Application
MIL_ENV=development
MIL_LOG_LEVEL=DEBUG

# Database — point to local Postgres if running without Docker
MIL_DATABASE_URL=postgresql+asyncpg://mil:mil@localhost:5432/mil
MIL_DATABASE_POOL_SIZE=5
MIL_DATABASE_MAX_OVERFLOW=5
MIL_DATABASE_STATEMENT_CACHE_SIZE=100

# JWT — generate: openssl rand -hex 32
MIL_JWT_SECRET=change-me-please
MIL_JWT_ALGORITHM=HS256
MIL_JWT_ACCESS_TTL_SECONDS=900
MIL_JWT_REFRESH_TTL_SECONDS=1209600

# CORS
MIL_CORS_ORIGINS=["http://localhost:5173"]

# Admin bootstrap
MIL_ADMIN_EMAIL=admin@example.com
MIL_ADMIN_PASSWORD=ChangeMe123!ChangeMe