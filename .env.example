# =====================================================================
# Docker Compose environment — copy to `.env` at repo root.
# This file is consumed by `infra/docker-compose.yml`.
# Application-specific variables belong in apps/*/.env.example.
# =====================================================================

# Postgres
POSTGRES_USER=mil
POSTGRES_PASSWORD=mil
POSTGRES_DB=mil
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# API
MIL_ENV=development
MIL_LOG_LEVEL=DEBUG
MIL_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
MIL_JWT_ALGORITHM=HS256
MIL_JWT_ACCESS_TTL_SECONDS=900
MIL_JWT_REFRESH_TTL_SECONDS=1209600
MIL_CORS_ORIGINS=["http://localhost:5173"]

# Frontend
VITE_API_URL=http://localhost:8000/api/v1